SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVER ONLY. Use the SECRET key (starts with sb_secret_...) or the legacy service_role key.
# Never expose this key in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Must be saved in the Spotify dashboard exactly like this (127.0.0.1, not localhost)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback

# Make one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=paste-the-generated-key-here

FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=50
